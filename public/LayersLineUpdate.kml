	<Folder id="FeatureLayer1">
		<name>Line Access road merge</name>
		<Snippet maxLines="0"></Snippet>
		<Placemark id="ID_10000">
			<name>0</name>
			<Snippet maxLines="0"></Snippet>
						<styleUrl>#LineStyle10</styleUrl>
			<MultiGeometry>
				<LineString>
